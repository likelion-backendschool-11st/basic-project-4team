# ─────────────────────────────────────────────────────────────
# 로컬 개발용 환경변수
# 이 파일을 복사해서 .env 를 만든 뒤, DB_PASSWORD 만 내 MySQL 비밀번호로 바꾸면 된다.
#   Mac:      cp .env.example .env
#   Windows:  copy .env.example .env
# .env 는 git에 올라가지 않는다. 새 항목을 추가하면 이 파일에도 추가할 것.
# ─────────────────────────────────────────────────────────────

# 백엔드 서버 포트 → http://localhost:4000
PORT=4000

# 프론트엔드 주소. 이 주소에서 오는 요청만 허용(CORS)하고 로그인 쿠키를 주고받는다. 채팅 WebSocket도 이 주소만 받는다.
# 프론트 dev 서버 주소(vite.config.ts)와 똑같아야 한다. 끝에 / 없이.
# 배포: Vercel 프론트 주소. 여러 개면 쉼표로 (예: https://repick.vercel.app,https://repick-git-main-팀.vercel.app)
CORS_ORIGIN=http://127.0.0.1:4173

# 백엔드 서버 주소. 업로드한 이미지 URL(http://127.0.0.1:4000/uploads/...)을 만들 때 쓴다.
# 배포 서버에서는 실제 도메인으로 바꿀 것.
PUBLIC_BASE_URL=http://127.0.0.1:4000

# 업로드 파일 저장 폴더 (backend 폴더 기준 상대 경로 또는 절대 경로). 비워두면 backend/uploads.
# 배포 서버에서는 재배포해도 지워지지 않는 폴더로 지정할 것.
UPLOAD_DIR=

# MySQL 접속 정보
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# ★ 내 로컬 MySQL root 비밀번호로 바꾸기 (비밀번호가 없으면 비워두기)
DB_PASSWORD=
# 사용할 데이터베이스 이름. npm run db:init 이 없으면 만들어 준다.
DB_NAME=repick

# 로그인 토큰(JWT) 서명 키. 로컬 개발용 값이라 그대로 써도 된다.
# 실제 배포 서버에서는 반드시 길고 랜덤한 값으로 바꿀 것.
JWT_SECRET=repick-local-dev-secret-do-not-use-in-production
# 로그인 유지 시간 (예: 30m, 1h, 7d)
JWT_EXPIRES_IN=1h

# 아이디·비밀번호 찾기 메일 발송 (SMTP)
# ★ SMTP_HOST를 비워두면 메일을 보내지 않고 백엔드 서버 콘솔(터미널)에 메일 내용을 출력한다 → 로컬 개발은 비워둬도 됨.
# Gmail 예시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=내 Gmail 주소, SMTP_PASS=앱 비밀번호
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RE:PICK <no-reply@repick.dev>

# ─────────────────────────────────────────────────────────────
# 배포 서버 전용 (로컬에서는 비워두기) — docs/deploy.md
# ─────────────────────────────────────────────────────────────
# production이면: 쿠키 Secure + SameSite=None(프론트·API 도메인이 달라도 로그인 유지), 프록시 헤더 신뢰
# NODE_ENV=production
# 쿠키 SameSite 직접 지정 (lax | strict | none). 비우면 production=none, 그 외=lax
COOKIE_SAMESITE=
# 프록시(Render·Railway 등) 뒤에서 실행. production이면 자동으로 true
TRUST_PROXY=
# 클라우드 MySQL이 TLS를 요구하면 true. CA 인증서가 필요하면 DB_SSL_CA에 PEM 내용(줄바꿈은 \n 두 글자로)
DB_SSL=
DB_SSL_CA=
# 자체 서명 인증서라 검증이 실패할 때만 false (가능하면 CA를 넣을 것)
DB_SSL_REJECT_UNAUTHORIZED=
