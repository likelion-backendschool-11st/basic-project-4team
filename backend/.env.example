# ─────────────────────────────────────────────────────────────
# 로컬 개발용 환경변수
# 이 파일을 복사해서 .env 를 만든 뒤, DB_PASSWORD 만 내 MySQL 비밀번호로 바꾸면 된다.
#   Mac:      cp .env.example .env
#   Windows:  copy .env.example .env
# .env 는 git에 올라가지 않는다. 새 항목을 추가하면 이 파일에도 추가할 것.
# ─────────────────────────────────────────────────────────────

# 백엔드 서버 포트 → http://localhost:4000
PORT=4000

# 프론트엔드 주소. 이 주소에서 오는 요청만 허용(CORS)하고 로그인 쿠키를 주고받는다.
# 프론트 dev 서버 주소(vite.config.ts)와 똑같아야 한다.
CORS_ORIGIN=http://127.0.0.1:4173

# MySQL 접속 정보
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# ★ 내 로컬 MySQL root 비밀번호로 바꾸기 (비밀번호가 없으면 비워두기)
DB_PASSWORD=
# 사용할 데이터베이스 이름. npm run db:init 이 없으면 만들어 준다.
DB_NAME=repick

# 로그인 토큰(JWT) 서명 키. 로컬 개발용 값이라 그대로 써도 된다.
# 실제 배포 서버에서는 반드시 길고 랜덤한 값으로 바꿀 것.
JWT_SECRET=repick-local-dev-secret-do-not-use-in-production
# 로그인 유지 시간 (예: 30m, 1h, 7d)
JWT_EXPIRES_IN=1h
